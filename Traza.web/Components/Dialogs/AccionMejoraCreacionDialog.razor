    private List<TareaAccionMejora> ConstruirTareasValidas()
    {
        return modelo.Tareas
            .Where(x => !string.IsNullOrWhiteSpace(x.Tarea) && x.UsuarioAsignadoId is not null)
            .Select(x => new TareaAccionMejora
            {
                UsuarioAsignadoId = x.UsuarioAsignadoId!.Value,
                Tarea = x.Tarea.Trim(),
                FechaFinEsperada = x.FechaFinEsperada,
                EsUrgente = x.EsUrgente,
                Cerrada = false
            })
            .ToList();
    }

    private List<ComentarioAccionMejora> ConstruirComentariosValidos()
    {
        return modelo.Comentarios
            .Where(x => !string.IsNullOrWhiteSpace(x.Contenido) && modelo.SolicitanteId is not null)
            .Select(x => new ComentarioAccionMejora
            {
                UsuarioId = x.UsuarioId ?? modelo.SolicitanteId!.Value,
                Fecha = x.Fecha == default ? DateTime.Now : x.Fecha,
                Contenido = x.Contenido.Trim(),
                EsSeguimiento = true
            })
            .ToList();
    }

    private async Task<List<DocumentoAccionMejora>> ConstruirDocumentosValidosAsync(List<string> rutasGuardadas)
    {
        var documentos = new List<DocumentoAccionMejora>();

        foreach (var item in modelo.Documentos.Where(x => !string.IsNullOrWhiteSpace(x.Titulo) && x.TipoAdjuntoId is not null && x.UsuarioId is not null && x.Archivo is not null))
        {
            var archivo = await DocumentStorageService.SaveAsync(item.Archivo!, "acciones-mejora");
            rutasGuardadas.Add(archivo.RelativePath);

            documentos.Add(new DocumentoAccionMejora
            {
                TipoAdjuntoId = item.TipoAdjuntoId!.Value,
                UsuarioId = item.UsuarioId!.Value,
                FechaDocumento = item.FechaDocumento,
                Titulo = item.Titulo.Trim(),
                Descripcion = string.IsNullOrWhiteSpace(item.Descripcion) ? null : item.Descripcion.Trim(),
                NombreArchivo = archivo.OriginalFileName,
                RutaArchivo = archivo.RelativePath
            });
        }

        return documentos;
    }

    private string ObtenerEstadoTexto()
        => estados.FirstOrDefault(x => x.Id == modelo.EstadoId)?.Nombre ?? "Sin estado";

    private string ObtenerOrigenTexto()
        => origenes.FirstOrDefault(x => x.Id == modelo.OrigenId)?.Nombre ?? "Sin origen";

    private string ObtenerTipoAccionTexto()
        => tiposAccion.FirstOrDefault(x => x.Id == modelo.TipoAccionId)?.Nombre ?? "Sin tipo";

    private string ObtenerDescripcionResumen()
        => string.IsNullOrWhiteSpace(modelo.Descripcion) ? "Sin descripcion" : modelo.Descripcion.Trim();

    private static string TruncarDescripcion(string descripcion)
    {
        if (string.IsNullOrWhiteSpace(descripcion))
        {
            return "(sin descripcion)";
        }

        return descripcion.Length <= 80
            ? descripcion
            : $"{descripcion[..80]}...";
    }

    private static string GetRowId(object item) => item.GetHashCode().ToString();

    private async Task SeleccionarArchivoDocumentoAsync(DocumentoAccionMejoraFormModel documento, InputFileChangeEventArgs args)
    {
        var archivo = args.File;
        documento.Archivo = archivo;
        documento.NombreArchivo = archivo.Name;

        if (string.IsNullOrWhiteSpace(documento.Titulo))
        {
            documento.Titulo = Path.GetFileNameWithoutExtension(archivo.Name);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task EliminarArchivosGuardadosAsync(IEnumerable<string> rutasGuardadas)
    {
        foreach (var ruta in rutasGuardadas)
        {
            await DocumentStorageService.DeleteAsync(ruta);
        }
    }

