@using Traza.Web.Services.AccionesMejora
@using Traza.Web.Services.Incidencias
@using Traza.Web.Services.Proyectos
@inject DialogService DialogService
@inject IncidenciaDialogCoordinator IncidenciaDialogCoordinator
@inject AccionMejoraDialogCoordinator AccionMejoraDialogCoordinator
@inject ProyectoDialogCoordinator ProyectoDialogCoordinator

<div class="p-4 traza-creation-selector">
    <div class="text-center mb-4">
        <h4 class="mb-2">Que quieres crear</h4>
        <div class="text-muted">Selecciona el flujo de alta con el que quieres trabajar.</div>
    </div>

    <div class="traza-creation-selector-grid">
        <button type="button" class="traza-creation-selector-card" @onclick="AbrirIncidenciaAsync">
            <span class="traza-creation-selector-icon bg-danger-subtle">
                <i class="fas fa-exclamation-triangle"></i>
            </span>
            <span class="traza-creation-selector-title">Incidencia</span>
            <span class="traza-creation-selector-text">Alta guiada de incidencias operativas.</span>
        </button>

        <button type="button" class="traza-creation-selector-card" @onclick="AbrirAccionAsync">
            <span class="traza-creation-selector-icon bg-success-subtle">
                <i class="fas fa-tasks"></i>
            </span>
            <span class="traza-creation-selector-title">Acción de mejora</span>
            <span class="traza-creation-selector-text">Registro de acciones con tareas y seguimiento.</span>
        </button>

        <button type="button" class="traza-creation-selector-card" @onclick="AbrirProyectoAsync">
            <span class="traza-creation-selector-icon bg-primary-subtle">
                <i class="fas fa-project-diagram"></i>
            </span>
            <span class="traza-creation-selector-title">Proyecto</span>
            <span class="traza-creation-selector-text">Creacion de proyectos con objetivos, fases y costes.</span>
        </button>
    </div>
</div>

@code {
    private async Task AbrirIncidenciaAsync()
    {
        DialogService.Close();
        await IncidenciaDialogCoordinator.AbrirNuevaAsync();
    }

    private async Task AbrirAccionAsync()
    {
        DialogService.Close();
        await AccionMejoraDialogCoordinator.AbrirNuevaAsync();
    }

    private async Task AbrirProyectoAsync()
    {
        DialogService.Close();
        await ProyectoDialogCoordinator.AbrirNuevoAsync();
    }
}
