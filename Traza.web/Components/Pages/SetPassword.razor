@page "/set-password"
@layout Traza.Web.Components.Layout.BlankLayout
@rendermode InteractiveServer

<PageTitle>Nueva contraseña | Traza</PageTitle>

<div class="traza-login-page">
    <div class="traza-login-shell">
        <section class="traza-login-brand">
            <div class="traza-login-brand-stack">
                <img src="img/traza-mark-light.svg" alt="Traza" class="traza-login-mark" />
                <div class="traza-login-brand-copy">
                    <h1>Traza</h1>
                    <p>Gestión industrial de incidencias, mejoras y proyectos.</p>
                </div>
            </div>
        </section>

        <section class="traza-login-panel">
            <div class="traza-login-card">
                <div class="traza-login-header">
                    <div class="traza-login-eyebrow">Acceso</div>
                    <h2>Nueva contraseña</h2>
                    <p>Define tu contraseña para entrar en Traza.</p>
                </div>

                @if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
                {
                    <div class="alert alert-danger" role="alert">El enlace de activación no es válido.</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="alert alert-danger" role="alert">@Mensaje</div>
                    }

                    <form class="traza-login-form" method="post" action="/account/set-password">
                        <AntiforgeryToken />
                        <input type="hidden" name="userId" value="@UserId" />
                        <input type="hidden" name="token" value="@Token" />

                        <div class="traza-login-field">
                            <label for="set-password">Nueva contraseña</label>
                            <input id="set-password" name="password" type="password" autocomplete="new-password" minlength="10" placeholder="Mínimo 10 caracteres" />
                        </div>

                        <div class="traza-login-field">
                            <label for="set-password-confirm">Confirmar nueva contraseña</label>
                            <input id="set-password-confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="10" placeholder="Repite la contraseña" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg traza-login-submit">
                            Entrar
                        </button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? Mensaje
        => Error switch
        {
            "required" => "Completa la contraseña y su confirmación.",
            "mismatch" => "Las contraseñas no coinciden.",
            "password" => "La contraseña no cumple los requisitos o el enlace ha caducado.",
            _ => null
        };
}
