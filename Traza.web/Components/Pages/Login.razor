@page "/login"
@attribute [AllowAnonymous]
@layout Traza.Web.Components.Layout.BlankLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Login | Traza</PageTitle>

<div class="traza-login-page">
    <div class="traza-login-shell">
        <section class="traza-login-brand">
            <div class="traza-login-brand-stack">
                <img src="img/traza-mark-light.svg" alt="Traza" class="traza-login-mark" />
                <div class="traza-login-brand-copy">
                    <h1>Traza</h1>
                    <p>Gestión industrial de incidencias, mejoras y proyectos.</p>
                </div>
            </div>
        </section>

        <section class="traza-login-panel">
            <div class="traza-login-card">
                <div class="traza-login-header">
                    <div class="traza-login-eyebrow">Acceso</div>
                    <h2>Iniciar sesión</h2>
                    <p>Introduce tus credenciales para entrar en Traza.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="@MensajeCss" role="alert">@Mensaje</div>
                }

                <form class="traza-login-form" method="post" action="/account/login">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <div class="traza-login-field">
                        <label for="login-usuario">Usuario</label>
                        <input id="login-usuario" name="userName" type="text" autocomplete="username" placeholder="Usuario" />
                    </div>

                    <div class="traza-login-field">
                        <label for="login-password">Contraseña</label>
                        <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Contraseña" />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="login-recordar" name="rememberMe" value="true" />
                        <label class="form-check-label" for="login-recordar">Mantener sesión iniciada</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg traza-login-submit">
                        Entrar
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "passwordSet")]
    private string? PasswordSet { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string? Mensaje
        => Error switch
        {
            "required" => "Introduce usuario y contraseña.",
            "locked" => "La cuenta está bloqueada temporalmente por demasiados intentos.",
            "invalid" => "Usuario o contraseña incorrectos.",
            _ when PasswordSet == "1" => "Contraseña establecida. Ya puedes iniciar sesión.",
            _ => null
        };

    private string MensajeCss
        => PasswordSet == "1" ? "alert alert-success" : "alert alert-danger";
}
