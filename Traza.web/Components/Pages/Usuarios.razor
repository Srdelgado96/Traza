@page "/usuarios"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using System.Text
@using Traza.Web.Components.Dialogs
@using Traza.Web.Components.Models
@using Traza.Web.Data
@using Traza.Web.Data.Entidades
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject DialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Usuarios | Traza</PageTitle>

@if (cargando)
{
    <div class="card card-round">
        <div class="card-body py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <div class="mt-3 text-muted">Cargando usuarios...</div>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div class="page-header-content">
            <h4 class="page-title">Usuarios</h4>
            <div class="text-muted">Vista general de usuarios internos con acceso a consulta, edición y eliminación.</div>
        </div>
        <button type="button" class="btn btn-primary btn-round" @onclick="CrearAsync">
            <i class="fas fa-user-plus me-1"></i>
            Nuevo usuario
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ultimoEnlaceActivación))
    {
        <div class="alert alert-info d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between">
            <div>
                <div class="fw-semibold">Enlace de activación generado</div>
                <div class="small text-break">@ultimoEnlaceActivación</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CopiarUltimoEnlaceAsync">
                <i class="fas fa-copy me-1"></i>
                Copiar
            </button>
        </div>
    }

    <div class="card card-round">
        <div class="card-body">
            <RadzenDataGrid Data="@usuarios" TItem="Usuario" AllowPaging="true" PageSize="10" EmptyText="No hay usuarios registrados.">
                <Columns>
                    <RadzenDataGridColumn TItem="Usuario" Property="Login" Title="Login" Width="140px" />
                    <RadzenDataGridColumn TItem="Usuario" Property="Nombre" Title="Nombre" />
                    <RadzenDataGridColumn TItem="Usuario" Property="Email" Title="Email" />
                    <RadzenDataGridColumn TItem="Usuario" Title="Roles">
                        <Template Context="item">@ObtenerRolesTexto(item)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Usuario" Title="Departamento">
                        <Template Context="item">@(item.Departamento?.Nombre ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Usuario" Title="Supervisor">
                        <Template Context="item">@(item.Supervisor?.Nombre ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Usuario" Title="Activo" Width="110px">
                        <Template Context="item">@(item.Activo ? "Sí" : "No")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Usuario" Title="Acciones" Width="190px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <button type="button" class="btn traza-icon-btn" @onclick="() => AbrirDetalleAsync(item.Id)" title="Ver">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button type="button" class="btn traza-icon-btn" @onclick="() => AbrirEdicionAsync(item.Id)" title="Editar">
                                <i class="fas fa-pencil-alt"></i>
                            </button>
                            <button type="button" class="btn traza-icon-btn" @onclick="() => GenerarEnlaceActivaciónAsync(item.Id)" title="Generar enlace de acceso">
                                <i class="fas fa-key"></i>
                            </button>
                            <button type="button" class="btn traza-icon-btn traza-icon-btn-danger" @onclick="() => EliminarAsync(item.Id)" title="Eliminar">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private List<Usuario> usuarios = [];
    private string? ultimoEnlaceActivación;

    protected override async Task OnInitializedAsync()
    {
        await RecargarAsync();
        cargando = false;
    }

    private async Task RecargarAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        usuarios = await db.Usuarios
            .AsNoTracking()
            .Include(x => x.Departamento)
            .Include(x => x.Supervisor)
            .Include(x => x.RolesAsignados).ThenInclude(x => x.Rol)
            .OrderBy(x => x.Nombre)
            .ToListAsync();
    }

    private async Task CrearAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var departamentos = await db.Departamentos.AsNoTracking().OrderBy(x => x.Nombre).ToListAsync();
        var supervisores = await db.Usuarios.AsNoTracking().OrderBy(x => x.Nombre).ToListAsync();
        var roles = await db.Roles.AsNoTracking().Where(x => x.Activo).OrderBy(x => x.Nombre).ToListAsync();

        var modelo = new UsuarioEdicionFormModel { Activo = true };
        var resultado = await DialogService.OpenAsync<UsuarioEdicionDialog>(
            "Nuevo usuario",
            new Dictionary<string, object?>
            {
                [nameof(UsuarioEdicionDialog.Modelo)] = modelo,
                [nameof(UsuarioEdicionDialog.Departamentos)] = departamentos,
                [nameof(UsuarioEdicionDialog.Supervisores)] = supervisores,
                [nameof(UsuarioEdicionDialog.Roles)] = roles
            },
            new DialogOptions { Width = "920px", Height = "700px", CloseDialogOnOverlayClick = true });

        if (resultado is not UsuarioEdicionFormModel nuevo || !ValidarUsuario(nuevo))
        {
            return;
        }

        var login = nuevo.Login.Trim();
        var email = nuevo.Email?.Trim();
        if (string.IsNullOrWhiteSpace(email))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Revisión requerida", "El email es obligatorio para generar el enlace de activación.");
            return;
        }

        if (await UserManager.FindByNameAsync(login) is not null || await UserManager.FindByEmailAsync(email) is not null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Usuario existente", "Ya existe un usuario de acceso con ese login o email.");
            return;
        }

        await using var dbGuardar = await DbContextFactory.CreateDbContextAsync();
        var entidad = new Usuario
        {
            Login = login,
            Nombre = nuevo.Nombre.Trim(),
            Email = email,
            Genero = string.IsNullOrWhiteSpace(nuevo.Genero) ? null : nuevo.Genero.Trim(),
            DepartamentoId = nuevo.DepartamentoId,
            SupervisorId = nuevo.SupervisorId,
            Activo = nuevo.Activo
        };

        dbGuardar.Usuarios.Add(entidad);
        foreach (var rolId in nuevo.RolesSeleccionados.Distinct())
        {
            dbGuardar.UsuariosRol.Add(new UsuarioRol { Usuario = entidad, RolId = rolId });
        }

        try
        {
            await dbGuardar.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "No se pudo guardar", "Revisa si el login ya existe o si hay datos obligatorios vacíos.");
            return;
        }

        var identityUser = new ApplicationUser
        {
            UserName = login,
            Email = email,
            EmailConfirmed = true,
            DisplayName = entidad.Nombre,
            IsActive = entidad.Activo,
            UsuarioId = entidad.Id
        };

        var identityResult = await UserManager.CreateAsync(identityUser);
        if (!identityResult.Succeeded)
        {
            await EliminarUsuarioFuncionalAsync(entidad.Id);
            NotificationService.Notify(NotificationSeverity.Error, "No se pudo crear el acceso", string.Join(" ", identityResult.Errors.Select(x => x.Description)));
            return;
        }

        ultimoEnlaceActivación = await CrearEnlaceActivaciónAsync(identityUser);
        NotificationService.Notify(NotificationSeverity.Success, "Usuario creado", "Copia el enlace de activación y enviaselo al usuario.");
        await RecargarAsync();
    }

    private async Task AbrirDetalleAsync(int id)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var usuario = await db.Usuarios
            .AsNoTracking()
            .Include(x => x.Departamento)
            .Include(x => x.Supervisor)
            .Include(x => x.RolesAsignados).ThenInclude(x => x.Rol)
            .FirstAsync(x => x.Id == id);

        var numeroColaboradores = await db.Usuarios.CountAsync(x => x.SupervisorId == id);
        var incidenciasDetectadas = await db.Incidencias.CountAsync(x => x.DetectorId == id);
        var incidenciasCoordinadas = await db.Incidencias.CountAsync(x => x.CoordinadorId == id);
        var accionesSolicitadas = await db.AccionesMejora.CountAsync(x => x.SolicitanteId == id);
        var proyectosCoordinados = await db.Proyectos.CountAsync(x => x.CoordinadorId == id);

        await DialogService.OpenAsync<UsuarioDetalleDialog>(
            "Ficha de usuario",
            new Dictionary<string, object?>
            {
                [nameof(UsuarioDetalleDialog.Usuario)] = usuario,
                [nameof(UsuarioDetalleDialog.NumeroColaboradores)] = numeroColaboradores,
                [nameof(UsuarioDetalleDialog.IncidenciasDetectadas)] = incidenciasDetectadas,
                [nameof(UsuarioDetalleDialog.IncidenciasCoordinadas)] = incidenciasCoordinadas,
                [nameof(UsuarioDetalleDialog.AccionesSolicitadas)] = accionesSolicitadas,
                [nameof(UsuarioDetalleDialog.ProyectosCoordinados)] = proyectosCoordinados,
                [nameof(UsuarioDetalleDialog.Roles)] = usuario.RolesAsignados.Select(x => x.Rol.Nombre).OrderBy(x => x).ToList()
            },
            new DialogOptions { Width = "900px", Height = "620px", CloseDialogOnOverlayClick = true });
    }

    private async Task AbrirEdicionAsync(int id)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var usuario = await db.Usuarios.AsNoTracking().FirstAsync(x => x.Id == id);
        var departamentos = await db.Departamentos.AsNoTracking().OrderBy(x => x.Nombre).ToListAsync();
        var supervisores = await db.Usuarios.AsNoTracking().Where(x => x.Id != id).OrderBy(x => x.Nombre).ToListAsync();
        var roles = await db.Roles.AsNoTracking().Where(x => x.Activo).OrderBy(x => x.Nombre).ToListAsync();
        var rolesSeleccionados = await db.UsuariosRol.AsNoTracking().Where(x => x.UsuarioId == id).Select(x => x.RolId).ToListAsync();

        var editable = new UsuarioEdicionFormModel
        {
            Id = usuario.Id,
            Login = usuario.Login,
            Nombre = usuario.Nombre,
            Email = usuario.Email,
            Genero = usuario.Genero,
            SupervisorId = usuario.SupervisorId,
            DepartamentoId = usuario.DepartamentoId,
            Activo = usuario.Activo,
            RolesSeleccionados = rolesSeleccionados
        };

        var resultado = await DialogService.OpenAsync<UsuarioEdicionDialog>(
            "Editar usuario",
            new Dictionary<string, object?>
            {
                [nameof(UsuarioEdicionDialog.Modelo)] = editable,
                [nameof(UsuarioEdicionDialog.Departamentos)] = departamentos,
                [nameof(UsuarioEdicionDialog.Supervisores)] = supervisores,
                [nameof(UsuarioEdicionDialog.Roles)] = roles
            },
            new DialogOptions { Width = "920px", Height = "700px", CloseDialogOnOverlayClick = true });

        if (resultado is not UsuarioEdicionFormModel editado)
        {
            return;
        }

        if (!ValidarUsuario(editado))
        {
            return;
        }

        await using var dbGuardar = await DbContextFactory.CreateDbContextAsync();
        var entidad = await dbGuardar.Usuarios.FindAsync(id);
        if (entidad is null)
        {
            return;
        }

        entidad.Login = editado.Login.Trim();
        entidad.Nombre = editado.Nombre.Trim();
        entidad.Email = string.IsNullOrWhiteSpace(editado.Email) ? null : editado.Email.Trim();
        entidad.Genero = string.IsNullOrWhiteSpace(editado.Genero) ? null : editado.Genero.Trim();
        entidad.DepartamentoId = editado.DepartamentoId;
        entidad.SupervisorId = editado.SupervisorId;
        entidad.Activo = editado.Activo;
        var rolesActuales = await dbGuardar.UsuariosRol.Where(x => x.UsuarioId == id).ToListAsync();
        dbGuardar.UsuariosRol.RemoveRange(rolesActuales);
        foreach (var rolId in editado.RolesSeleccionados.Distinct())
        {
            dbGuardar.UsuariosRol.Add(new UsuarioRol { UsuarioId = id, RolId = rolId });
        }

        try
        {
            await dbGuardar.SaveChangesAsync();
            await SincronizarIdentityAsync(entidad);
            NotificationService.Notify(NotificationSeverity.Success, "Guardado", "Usuario actualizado correctamente.");
            await RecargarAsync();
        }
        catch (DbUpdateException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "No se pudo guardar", "Revisa si el login ya existe o si hay datos obligatorios vacíos.");
        }
    }

    private async Task EliminarAsync(int id)
    {
        var confirmación = await DialogService.Confirm("El usuario se eliminará si no tiene relaciones activas con incidencias, acciones o proyectos.", "Eliminar usuario", new ConfirmOptions
        {
            OkButtonText = "Eliminar",
            CancelButtonText = "Cancelar"
        });

        if (confirmación != true)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var entidad = await db.Usuarios.FindAsync(id);
        if (entidad is null)
        {
            return;
        }

        db.Remove(entidad);

        try
        {
            await db.SaveChangesAsync();
            await DesactivarIdentityAsync(id);
            NotificationService.Notify(NotificationSeverity.Success, "Eliminado", "Usuario eliminado correctamente.");
            await RecargarAsync();
        }
        catch (DbUpdateException)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No se pudo eliminar", "Este usuario está relacionado con otros datos y no se puede borrar.");
        }
    }

    private bool ValidarUsuario(Usuario usuario)
    {
        return ValidarUsuario(new UsuarioEdicionFormModel
        {
            Id = usuario.Id,
            Login = usuario.Login,
            Nombre = usuario.Nombre,
            SupervisorId = usuario.SupervisorId
        });
    }

    private bool ValidarUsuario(UsuarioEdicionFormModel usuario)
    {
        if (string.IsNullOrWhiteSpace(usuario.Login))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Revisión requerida", "El login es obligatorio.");
            return false;
        }

        if (string.IsNullOrWhiteSpace(usuario.Nombre))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Revisión requerida", "El nombre es obligatorio.");
            return false;
        }

        if (usuario.SupervisorId == usuario.Id)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Revisión requerida", "Un usuario no puede ser su propio supervisor.");
            return false;
        }

        return true;
    }

    private async Task GenerarEnlaceActivaciónAsync(int usuarioId)
    {
        var identityUser = UserManager.Users.FirstOrDefault(x => x.UsuarioId == usuarioId);
        if (identityUser is null)
        {
            identityUser = await CrearCuentaAccesoAsync(usuarioId);
            if (identityUser is null)
            {
                return;
            }
        }

        ultimoEnlaceActivación = await CrearEnlaceActivaciónAsync(identityUser);
        NotificationService.Notify(NotificationSeverity.Info, "Enlace generado", "El enlace de activación está listo para copiar.");
    }

    private async Task<ApplicationUser?> CrearCuentaAccesoAsync(int usuarioId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var usuario = await db.Usuarios.AsNoTracking().FirstOrDefaultAsync(x => x.Id == usuarioId);
        if (usuario is null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Usuario no encontrado", "No se encontro el usuario seleccionado.");
            return null;
        }

        if (string.IsNullOrWhiteSpace(usuario.Email))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Email requerido", "El usuario necesita email para crear su cuenta de acceso.");
            return null;
        }

        var login = usuario.Login.Trim();
        var email = usuario.Email.Trim();
        if (await UserManager.FindByNameAsync(login) is not null || await UserManager.FindByEmailAsync(email) is not null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Acceso existente", "Ya existe una cuenta de acceso con ese login o email.");
            return null;
        }

        var identityUser = new ApplicationUser
        {
            UserName = login,
            Email = email,
            EmailConfirmed = true,
            DisplayName = usuario.Nombre,
            IsActive = usuario.Activo,
            UsuarioId = usuario.Id
        };

        var result = await UserManager.CreateAsync(identityUser);
        if (!result.Succeeded)
        {
            NotificationService.Notify(NotificationSeverity.Error, "No se pudo crear el acceso", string.Join(" ", result.Errors.Select(x => x.Description)));
            return null;
        }

        return identityUser;
    }

    private async Task<string> CrearEnlaceActivaciónAsync(ApplicationUser identityUser)
    {
        var token = await UserManager.GeneratePasswordResetTokenAsync(identityUser);
        var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
        return NavigationManager.ToAbsoluteUri($"/set-password?userId={Uri.EscapeDataString(identityUser.Id)}&token={encodedToken}").ToString();
    }

    private async Task SincronizarIdentityAsync(Usuario usuario)
    {
        var identityUser = UserManager.Users.FirstOrDefault(x => x.UsuarioId == usuario.Id);
        if (identityUser is null)
        {
            return;
        }

        identityUser.UserName = usuario.Login;
        identityUser.Email = usuario.Email;
        identityUser.EmailConfirmed = !string.IsNullOrWhiteSpace(usuario.Email);
        identityUser.DisplayName = usuario.Nombre;
        identityUser.IsActive = usuario.Activo;
        await UserManager.UpdateAsync(identityUser);
    }

    private async Task DesactivarIdentityAsync(int usuarioId)
    {
        var identityUser = UserManager.Users.FirstOrDefault(x => x.UsuarioId == usuarioId);
        if (identityUser is null)
        {
            return;
        }

        identityUser.IsActive = false;
        identityUser.UsuarioId = null;
        await UserManager.UpdateAsync(identityUser);
    }

    private async Task EliminarUsuarioFuncionalAsync(int usuarioId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var usuario = await db.Usuarios.FindAsync(usuarioId);
        if (usuario is null)
        {
            return;
        }

        db.Usuarios.Remove(usuario);
        await db.SaveChangesAsync();
    }

    private async Task CopiarUltimoEnlaceAsync()
    {
        if (string.IsNullOrWhiteSpace(ultimoEnlaceActivación))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ultimoEnlaceActivación);
        NotificationService.Notify(NotificationSeverity.Success, "Copiado", "Enlace de activación copiado al portapapeles.");
    }

    private static string ObtenerRolesTexto(Usuario usuario)
    {
        var roles = usuario.RolesAsignados
            .Select(x => x.Rol.Nombre)
            .OrderBy(x => x)
            .ToList();

        return roles.Count == 0 ? "-" : string.Join(", ", roles);
    }
}
