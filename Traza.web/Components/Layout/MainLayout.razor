@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Traza.Web.Components.Dialogs
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject UserManager<ApplicationUser> UserManager

<RadzenHost />

<div class="wrapper">
    <aside class="sidebar" data-background-color="dark">
        <div class="sidebar-logo">
            <div class="logo-header" data-background-color="dark">
                <a href="/" class="logo">
                    <img src="img/traza-logo-light.svg" alt="Traza" class="traza-logo-image" />
                </a>
                <div class="nav-toggle">
                    <button class="btn btn-toggle toggle-sidebar" type="button">
                        <i class="gg-menu-right"></i>
                    </button>
                    <button class="btn btn-toggle sidenav-toggler" type="button">
                        <i class="gg-menu-left"></i>
                    </button>
                </div>
                <button class="topbar-toggler more" type="button">
                    <i class="gg-more-vertical-alt"></i>
                </button>
            </div>
        </div>

        <div class="sidebar-wrapper scrollbar scrollbar-inner">
            <div class="sidebar-content">
                <ul class="nav nav-secondary">
                    <li class="nav-item active">
                        <a href="/">
                            <i class="icon-grid"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon">
                            <i class="icon-briefcase"></i>
                        </span>
                        <h4 class="text-section">Gestion</h4>
                    </li>

                    <li class="nav-item">
                        <a href="/incidencias">
                            <i class="icon-exclamation"></i>
                            <p>Gestion de Incidencias</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/acciones-mejoras">
                            <i class="icon-list"></i>
                            <p>Acciones de Mejora</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/proyectos">
                            <i class="icon-organization"></i>
                            <p>Gestion de Proyectos</p>
                        </a>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon">
                            <i class="icon-settings"></i>
                        </span>
                        <h4 class="text-section">Sistema</h4>
                    </li>

                    <li class="nav-item">
                        <a href="/gestion-tablas-maestras">
                            <i class="icon-layers"></i>
                            <p>Gestion de tablas maestras</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/usuarios">
                            <i class="icon-people"></i>
                            <p>Usuarios</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/">
                            <i class="icon-clock"></i>
                            <p>Auditoria</p>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </aside>

    <div class="main-panel">
        <div class="main-header">
            <div class="main-header-logo">
                <div class="logo-header" data-background-color="dark">
                    <a href="/" class="logo">
                        <img src="img/traza-logo-light.svg" alt="Traza" class="traza-logo-image traza-logo-image-mobile" />
                    </a>
                    <div class="nav-toggle">
                        <button class="btn btn-toggle toggle-sidebar" type="button">
                            <i class="gg-menu-right"></i>
                        </button>
                        <button class="btn btn-toggle sidenav-toggler" type="button">
                            <i class="gg-menu-left"></i>
                        </button>
                    </div>
                    <button class="topbar-toggler more" type="button">
                        <i class="gg-more-vertical-alt"></i>
                    </button>
                </div>
            </div>

            <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                <div class="container-fluid">
                    <div>
                        <div class="fw-semibold traza-app-name">Traza</div>
                        <div class="small text-muted">Gestion industrial de incidencias, acciones y proyectos</div>
                    </div>

                    <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
                        <li class="nav-item topbar-user dropdown hidden-caret">
                            <a class="dropdown-toggle profile-pic" data-bs-toggle="dropdown" href="#" aria-expanded="false">
                                <div class="avatar-sm">
                                    @if (!string.IsNullOrWhiteSpace(profileImagePath))
                                    {
                                        <img src="@profileImagePath" alt="@displayName" class="avatar-img rounded-circle" />
                                    }
                                    else
                                    {
                                        <span class="avatar-title rounded-circle border border-white bg-primary">@initials</span>
                                    }
                                </div>
                                <span class="profile-username">
                                    <span class="op-7">Usuario</span>
                                    <span class="fw-bold">@displayName</span>
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-user animated fadeIn">
                                <li>
                                    <a href="/perfil" class="dropdown-item" @onclick="EditarPerfilAsync" @onclick:preventDefault @onclick:stopPropagation>
                                        <i class="fas fa-user-edit me-2"></i>
                                        Editar perfil
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item ms-2">
                            <form method="post" action="/account/logout">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-outline-danger btn-round">
                                    <i class="fas fa-sign-out-alt me-1"></i>
                                    Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>

        <div class="container">
            <div class="page-inner">
                @Body
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    private string displayName = "Usuario";
    private string initials = "US";
    private string? profileImagePath;

    protected override async Task OnInitializedAsync()
    {
        await CargarPerfilAsync();
    }

    private async Task CargarPerfilAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);
        if (user is null)
        {
            return;
        }

        displayName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.UserName ?? "Usuario" : user.DisplayName;
        initials = BuildInitials(displayName);
        profileImagePath = user.ProfileImagePath;
    }

    private async Task EditarPerfilAsync()
    {
        var actualizado = await DialogService.OpenAsync<EditarPerfilDialog>(
            "Editar perfil",
            options: new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = true });

        if (actualizado == true)
        {
            await CargarPerfilAsync();
            StateHasChanged();
        }
    }

    private static string BuildInitials(string value)
    {
        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "US";
        }

        var result = string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
        return result.Length == 1 ? $"{result}{result}" : result;
    }
}
